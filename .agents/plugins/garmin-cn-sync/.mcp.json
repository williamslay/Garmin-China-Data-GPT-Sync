{
  "mcpServers": {
    "garmin_cn_sync": {
      "command": "pwsh",
      "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-File", "scripts/launch.ps1"],
      "cwd": ".",
      "enabled": true,
      "default_tools_approval_mode": "prompt",
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 300,
      "env_vars": ["LOCALAPPDATA", "USERPROFILE", "PATH", "GARMIN_CN_SYNC_DB", "GARMIN_CN_SYNC_IMPORT_DIR", "GARMIN_CN_SYNC_INTERVAL_SECONDS", "GARMIN_CN_SYNC_PROVIDER"]
    }
  }
}
